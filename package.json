{
  "name": "fitness-notebook",
  "version": "1.0.0",
  "private": true,
  "description": "A fitness log that looks and feels like a paper notebook. The whole app is one file: index.html.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "test:screenshots:update": "playwright test tests/e2e/screenshots.spec.js --update-snapshots",
    "test:mutation": "stryker run && node tests/mutation/survivors.js --check",
    "test:crap": "node --test \"tests/crap/*.test.js\" && node tests/crap/crap.js",
    "test:all": "npm test && npm run test:e2e && npm run test:crap && npm run test:mutation"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/tap-runner": "10.1.1",
    "acorn": "8.19.0"
  }
}
