{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": false,
    "noImplicitAny": false,
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true
  },
  "include": ["tests/**/*.js", "*.js", "*.mjs"],
  "exclude": ["node_modules", "reports", ".stryker-tmp", "test-results"]
}
